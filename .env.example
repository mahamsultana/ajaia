# Postgres connection string. Neon: copy the "pooled" connection string from the Neon console.
# Local Postgres example: postgres://postgres:postgres@localhost:5432/ajaia_docs
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ajaia_docs

# Any long random string. Used to sign the session cookie.
SESSION_SECRET=change-me-to-a-long-random-string
